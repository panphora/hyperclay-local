# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
dist/
build/*
# ...but build/ is electron-builder's buildResources, so it holds real inputs next to
# generated output. Ignoring the whole directory meant no runner could ever build:
# build-icons hard-fails without icon-1024.png, and electron-builder --win reads
# icon.ico without regenerating it. The platform icons are tracked as a fallback,
# not a source of truth: every build job runs build-icons first and overwrites them
# wherever sips/iconutil/ImageMagick exist.
!build/icon-1024.png
!build/dmg-background.png
!build/icon.icns
!build/icon.ico
!build/icon.png
executables/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
logs
*.log

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Electron specific
*.tgz
*.tar.gz

